<% content_for :title, "Búsqueda ##{@search.id}" %>
<% badge = { "budget" => "bg-sky-500/20 text-sky-300", "transcript" => "bg-emerald-500/20 text-emerald-300",
             "technical_doc" => "bg-amber-500/20 text-amber-300" } %>

<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="text-xs text-white/50">Búsqueda #<%= @search.id %> · <%= l @search.created_at, format: :short %> · <%= @search.duration_seconds %> s</div>
      <h1 class="text-xl font-bold tracking-tight text-white mt-1">«<%= @search.query_text %>»</h1>
    </div>
    <div class="flex gap-3 text-sm whitespace-nowrap">
      <%= link_to "Nueva búsqueda", new_rag_advanced_search_path, class: "font-bold text-brand hover:text-brand-soft" %>
      <%= link_to "Histórico", history_path(kind: "search"), class: "font-bold text-white/70 hover:text-white" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="rounded-md border border-white/10 bg-ink/30 p-4">
      <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Routing</div>
      <div class="mt-1 text-lg font-bold text-brand"><%= @search.routing["level"] %></div>
      <div class="mt-1 flex flex-wrap gap-1">
        <% Array(@search.routing["targets"]).each do |t| %>
          <span class="px-2 py-0.5 rounded text-xs font-bold <%= badge[t] %>"><%= t %></span>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-white/60"><%= @search.routing["reason"] %></p>
    </div>

    <div class="rounded-md border border-white/10 bg-ink/30 p-4">
      <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Técnica</div>
      <div class="mt-1 text-lg font-bold text-brand"><%= @search.technique %></div>
      <ul class="mt-2 space-y-1 text-xs text-white/70">
        <% @search.subqueries.each do |sq| %>
          <li><span class="font-bold text-white/90"><%= sq["topic"] %></span> · <%= sq["query"] %></li>
        <% end %>
      </ul>
    </div>

    <div class="rounded-md border border-white/10 bg-ink/30 p-4">
      <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Cardinalidad tras filtros</div>
      <% @search.cardinality.each do |collection, n| %>
        <div class="mt-1 flex justify-between text-sm">
          <span class="px-2 py-0.5 rounded text-xs font-bold <%= badge[collection] %>"><%= collection %></span>
          <span class="font-bold tabular-nums <%= n.to_i.zero? ? 'text-red-400' : 'text-white' %>"><%= n %></span>
        </div>
      <% end %>
      <% if @search.low_confidence? %>
        <p class="mt-2 text-xs text-red-400 font-bold">low_confidence: ningún resultado bajo el umbral</p>
      <% end %>
    </div>
  </div>

  <div class="rounded-md border border-white/10 bg-ink/20 p-3 text-xs text-white/50 font-mono">
    <%= @search.request_params.except("query_text").to_json %>
  </div>

  <div>
    <h2 class="text-xs uppercase tracking-tight text-white/50 font-bold mb-2">Resultados (<%= @search.chunks.size %>)</h2>
    <div class="space-y-3">
      <% @search.chunks.each_with_index do |c, i| %>
        <div class="rounded-md border border-white/10 bg-ink/30 p-4">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-bold text-white">#<%= i + 1 %></span>
            <span class="px-2 py-0.5 rounded font-bold <%= badge[c['collection']] %>"><%= c["collection"] %></span>
            <span class="font-mono text-white/80"><%= c["source_id"] || c["budget_id"] %></span>
            <span class="text-white/40"><%= c["chunk_type"] %></span>
            <% if c["project_year"].to_i.positive? %><span class="text-white/50"><%= c["sector"] %> · <%= c["project_year"] %></span><% end %>
            <span class="ml-auto font-bold tabular-nums text-brand">
              <% if c["relevance_score"] %>score <%= c["relevance_score"].round(3) %> · <% end %>dist <%= c["distance"].to_f.round(3) %>
            </span>
          </div>
          <p class="mt-2 text-sm text-white/80 whitespace-pre-line"><%= c["content"].to_s.truncate(600) %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
